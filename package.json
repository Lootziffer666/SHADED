{
  "name": "shaded",
  "version": "1.0.0",
  "private": true,
  "description": "SHADED runtime host: image-to-world engine with explicit contracts and no production editor UI.",
  "scripts": {
    "check": "node tools/check-ui-zero.mjs",
    "serve": "python3 -m http.server 8000",
    "verify:pwa": "node tools/verify-pwa.mjs",
    "verify:world-sandbox": "node tools/test-world-sandbox-runtime.mjs && node tools/test-world-sandbox.mjs",
    "materials:freestylized": "node tools/freestylized-materials.mjs all --resolution 1k",
    "materials:freestylized:catalog": "node tools/freestylized-materials.mjs catalog",
    "materials:freestylized:sync": "node tools/freestylized-materials.mjs sync --resolution 1k"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
