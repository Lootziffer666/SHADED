{
  "name": "shaded",
  "version": "2.0.0",
  "description": "SHADED — Ein Bild. Shader. Raum-Prototyp. Installierbares Paket mit Spatial Kernel.",
  "type": "module",
  "main": "dist/shaded.cjs.js",
  "module": "dist/shaded.esm.js",
  "exports": {
    ".": {
      "import": "./dist/shaded.esm.js",
      "require": "./dist/shaded.cjs.js"
    },
    "./runtime/*": "./dist/runtime/*",
    "./editor/*": "./dist/editor/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "verify": "node tools/verify.cjs",
    "verify:actors": "node tools/verify-actors.cjs",
    "verify:intrinsic": "node tools/verify-intrinsic.cjs",
    "verify:editor": "node tools/verify-editor.cjs",
    "orchestrate": "node tools/orchestrate.cjs",
    "pipeline": "node tools/pipeline/koelnmesse-pipeline.js",
    "pipeline:resume": "node tools/pipeline/koelnmesse-pipeline.js --resume",
    "lint": "eslint src --ext .js,.mjs,.ts",
    "typecheck": "tsc --noEmit",
    "check": "eslint src --ext .js,.mjs,.ts && tsc --noEmit"
  },
  "keywords": [
    "webgl",
    "shader",
    "spatial",
    "reconstruction",
    "material",
    "pbr"
  ],
  "author": "SHADED Team",
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.9.11",
    "proj4": "^2.21.0",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.0",
    "@vitejs/plugin-legacy": "^5.4.0",
    "ajv": "^8.17.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "playwright": "^1.45.0",
    "terser": "^5.31.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
