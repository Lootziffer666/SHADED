{
  "providers": {
    "depth-anything-3": {
      "command": "python3",
      "args": ["tools/providers/shaded_depth_anything_3.py", "--input", "{input}", "--output", "{output}", "--device", "{device}", "--precision", "{precision}", "--max-edge", "{max_edge}", "--point-budget", "{point_budget}"],
      "doctorArgs": ["tools/providers/shaded_depth_anything_3.py", "--doctor"]
    },
    "depth-anything-v2": {
      "command": "python3",
      "args": ["tools/providers/depth_anything_v2.py", "--input", "{input}", "--output", "{output}", "--device", "{device}", "--precision", "{precision}", "--max-edge", "{max_edge}", "--point-budget", "{point_budget}"],
      "doctorArgs": ["tools/providers/depth_anything_v2.py", "--doctor"]
    },
    "vggt": {
      "command": "python3",
      "args": ["tools/providers/shaded_vggt.py", "--input", "{input}", "--output", "{output}", "--device", "{device}", "--precision", "{precision}", "--max-edge", "{max_edge}", "--point-budget", "{point_budget}"],
      "doctorArgs": ["tools/providers/shaded_vggt.py", "--doctor"]
    },
    "colmap": {
      "command": "python3",
      "args": ["tools/providers/shaded_colmap.py", "--input", "{input}", "--output", "{output}", "--colmap", "{colmap}", "--device", "{device}", "--precision", "{precision}", "--max-edge", "{max_edge}", "--point-budget", "{point_budget}", "--dense-depth"],
      "doctorArgs": ["tools/providers/shaded_colmap.py", "--doctor"]
    },
    "mapanything": {
      "command": "python3",
      "args": ["tools/providers/shaded_mapanything.py", "--input", "{input}", "--output", "{output}", "--api-key", "{api_key}", "--api-url", "{api_url}", "--traffic-window-index", "{traffic_window_index}", "--device", "{device}", "--precision", "{precision}", "--max-edge", "{max_edge}", "--point-budget", "{point_budget}"],
      "doctorArgs": ["tools/providers/shaded_mapanything.py", "--doctor"]
    },
    "tsdf-fusion": {
      "command": "python3",
      "args": ["tools/providers/shaded_tsdf_fusion.py", "--depths", "{input}", "--cameras", "{cameras}", "--output", "{output}", "--voxel-size", "0.01", "--trunc", "0.05", "--point-budget", "{point_budget}"],
      "doctorArgs": ["tools/providers/shaded_tsdf_fusion.py", "--doctor"]
    },
    "ransac-planes": {
      "command": "python3",
      "args": ["tools/providers/shaded_ransac_planes.py", "--points", "{points}", "--output", "{output}", "--distance-threshold", "0.05", "--num-iterations", "1000", "--min-points", "10000"],
      "doctorArgs": ["tools/providers/shaded_ransac_planes.py", "--doctor"]
    }
  }
}
